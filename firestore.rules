rules_version = '2';
// Natom Visite - regole di sicurezza Firestore
// Solo gli utenti APPROVATI possono leggere/modificare il database negozi.
// Solo gli ADMIN possono approvare/rifiutare/revocare utenti e cambiare ruoli.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function bootstrapAdmin() {
      // Primo admin: Nadav, solo con email verificata
      return signedIn()
        && request.auth.token.email == 'nadavabramovraffael@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function approved() { return hasProfile() && me().stato == 'approvato'; }
    function isAdmin() { return bootstrapAdmin() || (approved() && me().ruolo == 'admin'); }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- Profili utente ----
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

      // Registrazione: sempre "in_attesa" / "venditore" (tranne il primo admin)
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0
        && request.resource.data.telefono is string
        // il permesso "vedere attivita'" lo da' solo l'admin
        && !('canViewActivityOf' in request.resource.data)
        && (
          (request.resource.data.stato == 'in_attesa' && request.resource.data.ruolo == 'venditore')
          || (bootstrapAdmin() && request.resource.data.stato == 'approvato' && request.resource.data.ruolo == 'admin')
        );

      // L'utente puo' cambiare solo nome/telefono; l'admin tutto (stato, ruolo, canViewActivityOf)
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && onlyChanged(['nome', 'telefono']))
        // il primo admin puo' auto-promuoversi se il suo profilo esiste gia'
        || (bootstrapAdmin() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    // ---- Database negozi (condiviso) ----
    match /shops/{shopId} {
      allow read: if approved() || isAdmin();
      allow create, update: if (approved() || isAdmin())
        && request.resource.data.modificato_uid == request.auth.uid
        && (isAdmin() || campNotTouched());
      allow delete: if isAdmin();

      // Storico modifiche: solo aggiunta, mai modifica/cancellazione
      match /history/{hId} {
        allow read: if approved() || isAdmin();
        allow create: if (approved() || isAdmin()) && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- Configurazione (versione dataset) ----
    match /config/{docId} {
      allow read: if approved() || isAdmin();
      allow write: if isAdmin();
    }

    // ================= Natom Campagne (SEZIONE DA UNIRE — NON pubblicare da sola) =================
    // Da incollare DENTRO "match /databases/{database}/documents { ... }" di Natom Visite,
    // PRIMA della regola finale "match /{document=**} { allow read, write: if false; }".
    // Il server Campagne (Railway) usa l'Admin SDK con account di servizio: le regole NON lo limitano.
    // Queste regole valgono solo per le app (Visite / pannello Campagne via client):
    //  - gli operatori approvati possono LEGGERE lo stato di campagna dei negozi (già coperto da /shops),
    //    ma NON possono toccare i campi camp_* (li scrive solo il server);
    //  - solo l'admin legge coda/eventi/guard; nessun client scrive coda, eventi, guard, indici, token.
    //
    // 1) MODIFICA alla regola esistente di /shops/{shopId} (allow create, update):
    //    aggiungere la condizione campNotTouched(), così un operatore non può cambiare i campi di campagna.
    //    Esempio:
    //      allow create, update: if (approved() || isAdmin())
    //        && request.resource.data.modificato_uid == request.auth.uid
    //        && (isAdmin() || campNotTouched());
    function campNotTouched() {
      return resource == null
        ? !request.resource.data.keys().hasAny(campKeys())
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(campKeys());
    }
    function campKeys() {
      return ['camp_wa_status','camp_wa_status_at','camp_wa_status_detail',
              'camp_last_reply_at','camp_last_reply_channel','camp_last_reply_class','camp_last_reply_text',
              'camp_wa_opt_out','camp_wa_opt_out_at','camp_wa_opt_out_reason',
              'camp_email_opt_out','camp_email_opt_out_at','camp_email_opt_out_reason','camp_email_bounced',
              'camp_non_settore','camp_stato','camp_whatsapp_probabile','camp_wa_duplicate_of',
              'camp_facebook','camp_instagram','camp_altri_contatti','camp_legacy_ids',
              'camp_queue_priority','camp_last_sync_at'];
    }

    // 2) Collezioni di Campagne: lettura solo admin, scrittura solo server (Admin SDK).
    match /camp_campaigns/{id}      { allow read: if isAdmin(); allow write: if false; }
    match /camp_queue/{id}          { allow read: if isAdmin(); allow write: if false; }
    match /camp_wa_events/{id}      { allow read: if isAdmin(); allow write: if false; }
    match /camp_email_events/{id}   { allow read: if isAdmin(); allow write: if false; }
    match /camp_messages/{id}       { allow read: if isAdmin(); allow write: if false; }
    match /camp_manual_sends/{id}   { allow read: if isAdmin(); allow write: if false; }
    match /camp_settings/{id}       { allow read: if isAdmin(); allow write: if false; }
    match /camp_meta/{id}           { allow read: if isAdmin(); allow write: if false; }
    match /wa_send_guard/{id}       { allow read: if isAdmin(); allow write: if false; }
    // indici: servono al server e al tasto SYNC (che chiama il server); nessun client li scrive
    match /phone_index/{id}         { allow read: if isAdmin(); allow write: if false; }
    match /email_index/{id}         { allow read: if isAdmin(); allow write: if false; }
    // token di disiscrizione: mai leggibili da client (la pagina di disiscrizione passa dal server)
    match /camp_unsub_tokens/{id}   { allow read, write: if false; }
    // ================= fine sezione Natom Campagne =================

    match /{document=**} { allow read, write: if false; }
  }
}
